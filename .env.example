# Database Configuration
DATABASE_URL=sqlite:///./compliance_kit.db

# Application Settings
APP_NAME="Compliance Automation Kit"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/compliance_kit.log

# File Storage
DATA_DIR=data
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_FILE_SIZE=100MB

# CKAN Integration
CKAN_URL=https://your-ckan-instance.org
CKAN_API_KEY=your-ckan-api-key-here
CKAN_ORGANIZATION=your-organization-slug

# FTP Integration (optional)
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_PATH=/compliance-data

# Security Settings
ALLOWED_FILE_EXTENSIONS=csv,xlsx,xls,pdf,json,yaml,yml
PII_REDACTION_ENABLED=true
PII_REDACTION_FIELDS=email,phone,ssn,tax_id,bank_account

# Scheduler Settings
SCHEDULER_TIMEZONE=Europe/Sofia
SCHEDULER_MAX_WORKERS=4
SCHEDULER_COALESCE=true
SCHEDULER_MISFIRE_GRACE_TIME=30

# OCR Settings (if enabled)
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng,bul
OCR_CONFIG=--psm 6

# Email Notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@compliance-kit.eu
ADMIN_EMAIL=admin@your-organization.eu

# Audit and Retention
AUDIT_RETENTION_DAYS=2555  # 7 years
CLEANUP_TEMP_FILES=true
BACKUP_ENABLED=false
BACKUP_S3_BUCKET=

# Development Settings
MOCK_CKAN=false
MOCK_FTP=false
GENERATE_TEST_DATA=false